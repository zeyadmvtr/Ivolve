# ==============================================================================
# Remediated & Hardened Node.js Dockerfile (ivolve-app:v2)
# ==============================================================================
# Update from vulnerable Debian Bullseye to minimal Alpine Linux
FROM node:20-alpine

ENV NODE_ENV=production

WORKDIR /app

COPY package.json ./

RUN npm install --omit=dev && npm cache clean --force

COPY app.js ./

RUN chown -R node:node /app

USER node

EXPOSE 3000

CMD ["node", "app.js"]
