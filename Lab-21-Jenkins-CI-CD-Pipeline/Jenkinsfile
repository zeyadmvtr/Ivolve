pipeline {
    agent any

    environment {
        REPO_URL           = 'https://github.com/Ibrahim-Adel15/DemoApp.git'
        DOCKER_HUB_USER    = 'zeyadmvtr'
        IMAGE_NAME         = 'demoapp'
        IMAGE_TAG          = "${BUILD_NUMBER}"
        FULL_IMAGE         = "${DOCKER_HUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}"
        DOCKER_CREDENTIALS = 'dockerhub-credentials' // Jenkins username/password credential ID
        KUBECONFIG_CRED_ID = 'jenkins-kubeconfig'    // Jenkins secret file / kubeconfig credential ID
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                echo ">>> Cloning repository from: ${REPO_URL}"
                git branch: 'main', url: "${REPO_URL}"
            }
        }

        stage('1. Build App') {
            steps {
                echo ">>> Building Java Spring Boot Application with Maven..."
                sh 'mvn clean package -DskipTests=false'
            }
        }

        stage('2. Build Docker Image') {
            steps {
                echo ">>> Building Docker image: ${FULL_IMAGE}"
                sh "docker build -t ${FULL_IMAGE} ."
            }
        }

        stage('3. Scan Docker Image') {
            steps {
                echo ">>> Scanning Docker Image for Vulnerabilities using Trivy..."
                // Runs Trivy security scan, generating report and exiting cleanly or failing on critical
                sh "trivy image --severity HIGH,CRITICAL --exit-code 0 ${FULL_IMAGE}"
            }
        }

        stage('4. Push Image to DockerHub') {
            steps {
                echo ">>> Authenticating and Pushing Image to Docker Hub..."
                withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDENTIALS}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                    sh "docker push ${FULL_IMAGE}"
                }
            }
        }

        stage('5. Delete Image Locally') {
            steps {
                echo ">>> Cleaning up local Docker image to conserve disk space..."
                sh "docker rmi ${FULL_IMAGE} || true"
            }
        }

        stage('6. Update Image in Deployment File') {
            steps {
                echo ">>> Updating k8s/deployment.yaml with new image tag: ${FULL_IMAGE}"
                sh """
                    sed -i.bak -E "s|image: ${DOCKER_HUB_USER}/${IMAGE_NAME}:.*|image: ${FULL_IMAGE}|g" k8s/deployment.yaml
                    grep "image:" k8s/deployment.yaml
                """
            }
        }

        stage('7. Deploy to Kubernetes Cluster') {
            steps {
                echo ">>> Deploying updated application to Kubernetes cluster in 'ivolve' namespace..."
                // Uses scoped jenkinsSA kubeconfig generated in Lab 19
                sh """
                    kubectl apply -f k8s/deployment.yaml -n ivolve
                    kubectl apply -f k8s/service.yaml -n ivolve
                    kubectl rollout status deployment/demo-app -n ivolve --timeout=120s
                """
            }
        }
    }

    post {
        always {
            echo "=========================================================="
            echo ">>> Pipeline Execution Completed for Build #${BUILD_NUMBER}"
            echo "=========================================================="
            cleanWs deleteDirs: true, notFailBuild: true
        }
        success {
            echo ">>> [SUCCESS] Build #${BUILD_NUMBER} deployed successfully to Kubernetes!"
        }
        failure {
            echo ">>> [FAILURE] Build #${BUILD_NUMBER} failed! Check console logs for details."
        }
    }
}
